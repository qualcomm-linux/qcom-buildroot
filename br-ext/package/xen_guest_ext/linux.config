# Merged into allnoconfig (KCONFIG_ALLCONFIG). xen_guest_ext.mk checks that
# every option below ends up set.
CONFIG_LOCALVERSION="-xen-guest"
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_GZIP=y
CONFIG_BINFMT_ELF=y
CONFIG_BINFMT_SCRIPT=y
CONFIG_PROC_FS=y
CONFIG_SYSFS=y
CONFIG_DEVTMPFS=y
CONFIG_PRINTK_TIME=y
CONFIG_XEN=y
CONFIG_HVC_XEN=y
CONFIG_ARM_FFA_TRANSPORT=y
CONFIG_TEE=y
CONFIG_OPTEE=y

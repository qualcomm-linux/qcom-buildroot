#!/bin/sh
# init of the Xen test guest: mount the kernel file systems, print the
# ready line and what the guest sees of a TEE, then stay up. A shutdown
# request from the toolstack runs /sbin/poweroff.
/bin/busybox mount -t proc proc /proc
/bin/busybox --install -s /bin
mount -t sysfs sysfs /sys
mount -t devtmpfs devtmpfs /dev
name=$(tr ' ' '\n' < /proc/cmdline | sed -n 's/^xenguest=//p' | tail -n 1)
echo "xen-guest: ready name=${name} vcpus=$(nproc)" \
	"hypervisor=$(cat /sys/hypervisor/type 2> /dev/null)" \
	"kernel=$(uname -r) uptime=$(cut -d ' ' -f 1 /proc/uptime)"
ffa=0 optee=0 tee0=0
dmesg | grep -q 'ARM FF-A: Firmware version' && ffa=1
dmesg | grep -q 'optee: initialized driver' && optee=1
[ -c /dev/tee0 ] && tee0=1
echo "xen-guest: tee name=${name} ffa=${ffa} optee=${optee} tee0=${tee0}"
while :; do
	sleep 3600
done

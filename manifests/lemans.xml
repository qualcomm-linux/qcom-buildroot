<?xml version="1.0" encoding="UTF-8"?>
<manifest>
  <include name="manifests/common.xml" />
  <remote name="qcl"   fetch="https://github.com/qualcomm-linux" />
  <remote name="tfa"   fetch="https://review.trustedfirmware.org/TF-A" />
  <remote name="optee" fetch="https://github.com/OP-TEE" />
  <remote name="ea"    fetch="https://github.com/EmbeddedAndroid" />

  <project path="build" remote="qcl" name="qcom-buildroot.git" revision="features/lemans/security/dtpm-drtm">
    <linkfile src="lemans.mk" dest="build/Makefile" />
  </project>

  <remove-project                      name="linaro-swg/linux.git" />
  <remove-project                      name="OP-TEE/optee_os.git" />

  <!-- The DRTM trees: features/lemans/drtm of each project. -->
  <project path="linux"                remote="ea"    name="linux.git"                revision="features/lemans/drtm" clone-depth="10" sync-tags="false"/>
  <project path="arm-trusted-firmware" remote="ea"    name="arm-trusted-firmware.git" revision="features/lemans/drtm"/>
  <project path="optee_os"             remote="ea"    name="optee_os.git"             revision="features/lemans/drtm"/>
  <project path="xen"                  remote="ea"    name="xen.git"                  revision="features/lemans/drtm"/>
  <!-- Not built: the test definitions LAVA_TEST_BRANCH points flash-lava-test at. -->
  <project path="test-definitions"     remote="ea"    name="test-definitions.git"     revision="features/lemans/drtm"/>
  <!-- xtest from 962b322 (regression 1048) needs the stack protector PTA
       commands of a newer optee_os than features/lemans/drtm. -->
  <extend-project name="OP-TEE/optee_test.git" revision="e92a1880e74b45c5ff31b8d5b917ab2278f06760"/>
  <project path="u-boot"               remote="qcl"   name="u-boot.git"               revision="3902cb4183e03ce6349b7c465123735ba6df34d9" upstream="qcom-next"/>
</manifest>

-	ctx = devm_qcom_pas_context_alloc(dev, VENUS_PAS_ID, mem_phys, res_size);
-	if (!ctx) {
-		dev_err(core->dev, "%s: ctx is null\n", __func__);
-		return -ENOMEM;
-	}

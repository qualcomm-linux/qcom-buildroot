 static int venus_shutdown_no_tz(struct venus_core *core)
@@ -238,6 +244,37 @@ static int venus_shutdown_no_tz(struct venus_core *core)
 	return 0;
 }
 
+static int venus_shutdown_tee(struct venus_core *core)
+{
+	const size_t mapped = core->fw.mapped_mem_size;
+	struct iommu_domain *iommu;
+	size_t unmapped;
+	struct device *dev = core->fw.dev;
+	int ret;
+
+	if (core->use_tz != VENUS_TZ_OPTEE)
+		return -1;
+
+	ret = qcom_pas_shutdown(VENUS_PAS_ID);
+	if (ret) {
+		dev_err(dev, "failed to shutdown venus\n");
+		return ret;
+	}
+
+	iommu = core->fw.iommu_domain;
+
+	if (core->fw.mapped_mem_size && iommu) {
+		unmapped = iommu_unmap(iommu, VENUS_FW_START_ADDR, mapped);
+
+		if (unmapped != mapped)
+			dev_err(dev, "failed to unmap firmware\n");
+		else
+			core->fw.mapped_mem_size = 0;
+	}
+
+	return 0;
+}
+
 int venus_firmware_cfg(struct venus_core *core)
 {
 	void __iomem *cpu_cs_base = core->cpu_cs_base;
@@ -252,37 +289,38 @@ int venus_boot(struct venus_core *core)
 {
 	struct device *dev = core->dev;
 	const struct venus_resources *res = core->res;
